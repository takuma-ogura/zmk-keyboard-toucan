#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3

/ {
    macros {
        // Trackpad tap -> self-contained left click, completed entirely on the central half.
        // Why: the tap's BTN_0 press/release are sent right half -> left half as separate
        // BLE notifications (service.c bt_gatt_notify) and enqueued with K_NO_WAIT
        // (input_split.c). The pinnacle driver only reports button *changes*, so if a
        // single release is lost the HID left button stays latched until reboot and the
        // host ignores every physical click. Emitting press+release here removes that path.
        tap_click: tap_click {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <20>;
            bindings = <&mkp LCLK>;
        };

        // SYM layer: trackpad tap -> self-contained mouse "back" button (MB4).
        sym_back_tap: sym_back_tap {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <20>;
            bindings = <&mkp MB4>;
        };

        // ADJ layer: trackpad tap -> self-contained mouse "forward" button (MB5).
        adj_forward_tap: adj_forward_tap {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <20>;
            bindings = <&mkp MB5>;
        };

        physical_sym: physical_sym {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <
                &macro_press
                &mo 2
                &macro_pause_for_release
                &macro_release
                &mkp MB4
                &mo 2
            >;
        };
    };

    input_processors {
        tap_click_processor: tap_click_processor {
            compatible = "zmk,input-processor-behaviors";
            #input-processor-cells = <0>;
            codes = <INPUT_BTN_0>;
            bindings = <&tap_click>;
        };

        adj_forward_processor: adj_forward_processor {
            compatible = "zmk,input-processor-behaviors";
            #input-processor-cells = <0>;
            codes = <INPUT_BTN_0>;
            bindings = <&adj_forward_tap>;
        };

        sym_back_processor: sym_back_processor {
            compatible = "zmk,input-processor-behaviors";
            #input-processor-cells = <0>;
            codes = <INPUT_BTN_0>;
            bindings = <&sym_back_tap>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                &kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
                &kp LCTRL &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
                &kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp ESC
                                &kp LGUI &mo 1 &kp SPACE   &kp RET &physical_sym &kp RALT
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
                &kp LA(SPACE) &kp N1          &kp N2       &kp N3       &kp N4       &kp N5         &kp N6   &kp N7   &kp N8 &kp N9    &kp N0 &kp BSPC
                &trans      &trans          &trans       &trans       &trans       &trans         &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans &trans
                &kp LSHFT   &studio_unlock  &studio_unlock &trans      &trans       &trans         &trans   &trans   &trans &trans    &trans &trans
                                                &kp LGUI     &trans       &kp SPACE      &kp RET  &trans   &kp RALT
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
                &kp TAB   &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp KP_MULTIPLY &kp LPAR &kp RPAR &kp BSPC
                &kp LCTRL &trans   &trans &trans   &trans   &kp EXCL    &kp MINUS &kp EQUAL &kp LBKT        &kp RBKT &kp BSLH &kp GRAVE
                &kp LSHFT &trans   &trans &trans   &trans   &kp QMARK   &kp UNDER &kp PLUS  &kp LBRC        &kp RBRC &kp PIPE &kp TILDE
                                          &kp LGUI &trans   &kp SPACE   &kp RET   &trans    &kp RALT
            >;
        };

        adj {
            display-name = "ADJ";
            bindings = <
                &mo TAB   &trans &kp F7 &kp F8 &kp F9 &kp F12   &kp C_VOL_DN &kp C_MUTE  &kp C_VOL_UP &trans &trans &kp BSPC
                &kp LCTRL &bt BT_SEL 1  &kp F4 &kp F5 &kp F6 &kp F11   &kp C_BRI_DN &trans       &kp C_BRI_UP &trans       &bt BT_CLR   &bt BT_SEL 0
                &kp LSHFT &trans &kp F1 &kp F2 &kp F3 &kp F10   &trans       &trans      &trans       &trans       &trans       &trans
                                   &kp LGUI &mo NAV &kp SPACE   &kp RET &physical_sym &kp RALT
            >;
        };
        extra_1 {
                status = "reserved";
        };

        extra_2 {
                status = "reserved";
        };

        extra_3 {
                status = "reserved";
        };
    };
};
